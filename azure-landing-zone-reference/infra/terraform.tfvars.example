# Copy to terraform.tfvars and set your own non-production subscription ID.
# terraform.tfvars is ignored by the project .gitignore.
subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "centralindia"
project         = "littlenest"
environment     = "nonprod"
owner           = "replace-with-your-owner-tag"
cost_center     = "learning"

# Required: public IPv4 address of the Terraform workstation, without /32.
# This single address is the only internet source allowed by the Storage firewall.
terraform_runner_public_ip = "REPLACE_WITH_YOUR_PUBLIC_IPV4"

# Use User for interactive az login; use ServicePrincipal for CI/CD identities.
deployer_principal_type = "User"

# Only request the Cosmos DB Free Tier if this subscription is eligible
# and does not already have another Free Tier account.
enable_cosmos_free_tier = true

# Optional private Linux test VM. Keep false for the default low-cost deployment.
vm_enabled = false
vm_size    = "Standard_B1s"
# vm_admin_ssh_public_key = "ssh-ed25519 AAAA... your-public-key"
